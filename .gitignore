# AI Hotspot - Git ignore rules

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Operating system
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# JavaScript / Next.js
node_modules/
.next/
out/
dist/
coverage/
.turbo/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Spring Boot
target/
.gradle/
build/
*.class
*.jar
*.war
hs_err_pid*

# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Docker runtime data and local volumes
.runtime/
runtime/
volumes/
docker-data/
postgres-data/
redis-data/
rabbitmq-data/
minio-data/
mailpit-data/

# Application runtime artifacts
uploads/
exports/
generated-reports/
crawl-artifacts/
raw-documents/
page-snapshots/

# Local model files and caches
/models/
/model-cache/
/huggingface-cache/
*.bin
*.safetensors
*.onnx

# Test and browser artifacts
playwright-report/
test-results/
blob-report/
screenshots-temp/
videos/
traces/

# Local databases
*.db
*.sqlite
*.sqlite3

