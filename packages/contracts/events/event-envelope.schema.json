{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hotspot.local/contracts/events/event-envelope.schema.json",
  "title": "AI Hotspot Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "eventType", "eventVersion", "aggregateType", "aggregateId",
    "idempotencyKey", "correlationId", "traceId", "occurredAt", "producer", "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1 },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "aggregateType": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
