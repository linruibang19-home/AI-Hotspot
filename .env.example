# Shared
AI_HOTSPOT_ENV=development
AI_HOTSPOT_VERSION=0.1.0

# Web
CORE_API_INTERNAL_URL=http://core-api:8080
NEXT_PUBLIC_CORE_API_URL=/api/core

# PostgreSQL + pgvector
POSTGRES_DB=ai_hotspot
POSTGRES_USER=ai_hotspot
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST_PORT=15432
CORE_DATABASE_URL=jdbc:postgresql://postgres:5432/ai_hotspot
AI_DATABASE_URL=postgresql+psycopg://ai_hotspot:change-me-in-local-env@postgres:5432/ai_hotspot

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-in-local-env
REDIS_HOST_PORT=16379

# Session / development bootstrap administrator
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@aihotspot.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use
BOOTSTRAP_ADMIN_DISPLAY_NAME=AI Hotspot 管理员
EMAIL_CODE_PEPPER=replace-with-a-long-random-secret-in-production
EMAIL_CODE_LIFETIME_SECONDS=600
MODEL_CREDENTIAL_MASTER_KEY=replace-with-at-least-32-random-characters
AI_INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters

# RabbitMQ
RABBITMQ_DEFAULT_USER=ai_hotspot
RABBITMQ_DEFAULT_PASS=change-me-in-local-env
RABBITMQ_DEFAULT_VHOST=ai_hotspot
RABBITMQ_URL=amqp://ai_hotspot:change-me-in-local-env@rabbitmq:5672/ai_hotspot

# MinIO
MINIO_ROOT_USER=ai_hotspot
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ai-hotspot

# Mail
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=AI Hotspot <noreply@aihotspot.local>
UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret-in-production
PUBLIC_BASE_URL=http://127.0.0.1:3000

# M1 local infrastructure smoke (disable outside local development)
AI_HOTSPOT_SMOKE_ENABLED=true
OUTBOX_ENABLED=true
OUTBOX_FIXED_DELAY_MS=1000
OUTBOX_BATCH_SIZE=20

# AI Providers - Mock can test the pipeline but its output is quarantined and never public.
GENERATION_PROVIDER=mock
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-v4-flash
GENERATION_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
RERANK_PROVIDER=mock
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
